# ---- LLM access (via LiteLLM proxy) ----
# The agents never read ANTHROPIC_API_KEY directly; it lives in the LiteLLM proxy.
# llm.py talks to the proxy using per-agent virtual keys below.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Fallbacks are Claude-only by default (see litellm/config.yaml), so a single
# Anthropic key is all you need. To add a second provider for true provider-level
# fallback, set its key here and point the fallback at it in litellm/config.yaml.
# OPENAI_API_KEY=

# LiteLLM proxy endpoint + per-agent virtual keys (see litellm/config.yaml).
# The proxy runs DB-backed (DATABASE_URL in docker-compose.yml), so each agent
# gets its own budgeted, model-scoped virtual key. Generate them with:
#     make litellm-keys        # mints 4 keys and rewrites the LITELLM_KEY_* below
# The admin UI (http://localhost:4000/ui) shows their spend/budgets; log in as
# `admin` with LITELLM_MASTER_KEY as the password.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-master
# Placeholders — overwritten by `make litellm-keys`. Until then they fall back to
# the master key (works, but no per-agent budget/scoping).
LITELLM_KEY_PLANNER=sk-local-master
LITELLM_KEY_WRITER=sk-local-master
LITELLM_KEY_VERIFIER=sk-local-master
LITELLM_KEY_EXPLAINER=sk-local-master

# cassette layer: live | record | replay
LLM_MODE=replay

# ---- Postgres ----
# Analytics target data lives in the `shop` schema; app state (pgvector, traces,
# langgraph checkpoints) lives in the `app` schema.
PG_HOST=localhost
PG_PORT=5432
PG_DB=nl2sql
PG_APP_USER=nl2sql_app
PG_APP_PASSWORD=nl2sql_app_pw
# Least-privilege read-only role used by the SQL executor sandbox
PG_RO_USER=analyst_ro
PG_RO_PASSWORD=analyst_ro_pw

# ---- Observability ----
# OTLP endpoint for Arize Phoenix (docker-compose service)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
OTEL_SERVICE_NAME=nl2sql-agent-harness

# ---- Embeddings ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Executor sandbox limits ----
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=1000
SQL_MAX_EXPLAIN_COST=50000000

# ---- Agent loop budget ----
# Wall-clock is a safety net; keep it above a full max_retries loop of live calls.
MAX_RETRIES=2
MAX_WALLCLOCK_SECONDS=180
